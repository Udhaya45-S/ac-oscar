# Flask
FLASK_SECRET_KEY=
FLASK_DEBUG=false
PORT=5000

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSCODE=

# MySQL database
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=oscar_air_care

# Twilio SMS notifications (optional — booking still works without these,
# it just skips sending SMS and logs a message instead)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Twilio WhatsApp notification to the business owner on every new booking
# (uses the Twilio Sandbox number by default — no need to change
# TWILIO_WHATSAPP_FROM unless you've set up a dedicated WhatsApp sender)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP_NUMBER=
