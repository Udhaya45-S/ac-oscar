# Copy this file to .env and fill in real values. Never commit the real .env file.

# Flask
FLASK_SECRET_KEY=replace_with_output_of_python_-c_"import secrets; print(secrets.token_hex(32))"
FLASK_DEBUG=false
PORT=5000

# Admin login (used on /admin)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSCODE=replace_with_a_strong_passcode

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_db_password
DB_NAME=oscar_air_care
